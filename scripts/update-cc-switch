#!/usr/bin/env bash

# Builds a locally managed pacman package from GitHub release metadata.
# stdout is a tab-separated event stream consumed by update-watchdog-tray.
set -u
set -o pipefail

readonly PACKAGE_NAME="cc-switch-bin"
readonly RELEASE_API="https://api.github.com/repos/farion1231/cc-switch/releases/latest"
readonly STATE_DIR="${XDG_STATE_HOME:-$HOME/.local/state}/update-watchdog"
readonly DATA_DIR="${XDG_DATA_HOME:-$HOME/.local/share}/update-watchdog"
readonly TEMPLATE_PATH="$DATA_DIR/PKGBUILD.in"

work_dir=""
log_file=""

sanitize() {
    local value=${1-}
    value=${value//$'\t'/ }
    value=${value//$'\r'/ }
    value=${value//$'\n'/ }
    printf '%s' "$value"
}

event() {
    local type=$1
    shift
    printf '%s' "$type"
    local field
    for field in "$@"; do
        printf '\t%s' "$(sanitize "$field")"
    done
    printf '\n'
}

progress() {
    event PROGRESS "$1" "$2" "$3" "$4"
}

log() {
    event LOG "$1" "$2"
}

warning() {
    event WARNING "$1" "$2" "$3"
}

fail() {
    event ERROR "$1" "$2" "$3"
    exit 1
}

tail_log() {
    tail -n 12 "$log_file" 2>/dev/null | tr '\n\t\r' '   '
}

fail_from_log() {
    local code=$1
    local title=$2
    local detail
    detail=$(tail_log)
    [[ -n $detail ]] || detail="命令未返回可用诊断信息。"
    fail "$code" "$title" "$detail"
}

cleanup() {
    if [[ -n $work_dir && -d $work_dir ]]; then
        rm -rf -- "$work_dir"
    fi
}

cancelled() {
    fail E_CANCELLED "更新已取消" "取消发生在可安全中断的阶段；未安装新软件包。"
}

trap cleanup EXIT
trap cancelled INT TERM

require_command() {
    local command=$1
    command -v "$command" >/dev/null 2>&1 ||
        fail E_PRECONDITION "缺少升级依赖" "未找到必需命令：$command"
}

run_logged() {
    "$@" >>"$log_file" 2>&1
}

main() {
    local command cache_dir installed release target asset_name asset_url asset_digest asset_size checksum
    local comparison package_file installed_after
    local -a privilege_command

    progress 2 "正在检查环境" "验证本地打包和安装工具。" true
    for command in ar awk bsdtar curl flock grep jq makepkg mkdir mktemp pacman sed sha256sum tail tar tr vercmp; do
        require_command "$command"
    done

    mkdir -p "$STATE_DIR" || fail E_PRECONDITION "无法创建状态目录" "$STATE_DIR"
    log_file="$STATE_DIR/cc-switch-upgrade.log"
    : >"$log_file" || fail E_PRECONDITION "无法写入升级日志" "$log_file"

    exec 9>"$STATE_DIR/package-upgrade.lock" ||
        fail E_PRECONDITION "无法创建升级锁" "$STATE_DIR/package-upgrade.lock"
    flock -n 9 || fail E_CONCURRENT "已有软件升级正在进行" "请等待另一个 Update Watchdog 升级任务完成。"

    installed=$(pacman -Q "$PACKAGE_NAME" 2>>"$log_file" | awk '{print $2}') ||
        fail_from_log E_INSTALLED_VERSION "无法读取已安装版本"
    installed=${installed%-[0-9]*}
    [[ $installed =~ ^[0-9]+(\.[0-9]+)+([-.][A-Za-z0-9.]+)?$ ]] ||
        fail E_INSTALLED_VERSION "已安装版本格式无效" "$installed"

    progress 8 "正在获取发布信息" "检查 GitHub 上的最新稳定版。" true
    release=$(curl --fail --silent --show-error --location --retry 3 --retry-all-errors \
        --connect-timeout 10 --max-time 60 --proto '=https' --tlsv1.2 "$RELEASE_API" 2>>"$log_file") ||
        fail_from_log E_RELEASE_METADATA "无法获取 GitHub 发布信息"

    target=$(jq -er '.tag_name | sub("^v"; "")' <<<"$release" 2>>"$log_file") ||
        fail_from_log E_RELEASE_VERSION "发布版本信息无效"
    [[ $target =~ ^[0-9]+(\.[0-9]+)+([-.][A-Za-z0-9.]+)?$ ]] ||
        fail E_RELEASE_VERSION "发布版本格式无效" "$target"

    comparison=$(vercmp "$target" "$installed" 2>>"$log_file") ||
        fail_from_log E_RELEASE_VERSION "无法比较版本"
    if (( comparison <= 0 )); then
        progress 100 "已是最新版本" "CC Switch 已安装 $installed。" false
        event RESULT already-current "$installed" "当前版本已不低于 GitHub 发布版 $target。"
        return 0
    fi

    asset_name="CC-Switch-v${target}-Linux-x86_64.deb"
    asset=$(jq -er --arg name "$asset_name" '
        .assets[] | select(.name == $name)
        | [.browser_download_url, .digest, .size] | @tsv
    ' <<<"$release" 2>>"$log_file") ||
        fail_from_log E_RELEASE_ASSET "发布中缺少 Linux 安装包"
    IFS=$'\t' read -r asset_url asset_digest asset_size <<<"$asset" ||
        fail E_RELEASE_ASSET "发布资产信息无效" "$asset_name"
    [[ $asset_url == https://github.com/* && $asset_digest =~ ^sha256:[0-9a-f]{64}$ && $asset_size =~ ^[0-9]+$ ]] ||
        fail E_RELEASE_ASSET "发布资产校验信息无效" "$asset_name"
    checksum=${asset_digest#sha256:}

    cache_dir="${XDG_CACHE_HOME:-$HOME/.cache}/update-watchdog"
    mkdir -p "$cache_dir" || fail E_PRECONDITION "无法创建缓存目录" "$cache_dir"
    work_dir=$(mktemp -d "$cache_dir/cc-switch.XXXXXX") ||
        fail E_PRECONDITION "无法创建临时构建目录" "请检查磁盘空间和缓存目录权限。"

    progress 20 "正在下载更新" "下载 CC Switch $target 官方安装包。" true
    if ! run_logged curl --fail --silent --show-error --location --retry 3 --retry-all-errors \
        --connect-timeout 10 --max-time 300 --proto '=https' --tlsv1.2 \
        --output "$work_dir/$asset_name" "$asset_url"; then
        fail_from_log E_DOWNLOAD "下载官方安装包失败"
    fi

    progress 42 "正在验证安装包" "核对 GitHub Release 提供的 SHA-256。" true
    printf '%s  %s\n' "$checksum" "$asset_name" >"$work_dir/SHA256SUMS"
    if ! (cd "$work_dir" && run_logged sha256sum --check --status SHA256SUMS); then
        fail_from_log E_CHECKSUM "安装包校验失败"
    fi
    if ! run_logged bsdtar -tf "$work_dir/$asset_name"; then
        fail_from_log E_ARCHIVE "安装包结构无效"
    fi

    [[ -r $TEMPLATE_PATH ]] ||
        fail E_TEMPLATE "找不到本地打包模板" "$TEMPLATE_PATH"
    if ! sed -e "s/@PKGVER@/$target/g" -e "s/@SHA256@/$checksum/g" \
        "$TEMPLATE_PATH" >"$work_dir/PKGBUILD"; then
        fail E_TEMPLATE "无法生成本地打包配方" "$TEMPLATE_PATH"
    fi

    progress 58 "正在构建本地软件包" "将已校验的发布包交给 pacman 管理。" true
    if ! (cd "$work_dir" && run_logged makepkg -f); then
        fail_from_log E_BUILD "构建本地 pacman 软件包失败"
    fi
    package_file="$work_dir/${PACKAGE_NAME}-${target}-1-x86_64.pkg.tar.zst"
    [[ -f $package_file ]] ||
        fail E_BUILD "未生成预期的软件包" "$package_file"

    progress 78 "正在安装更新" "系统可能请求管理员授权；此阶段不能安全取消。" false
    if sudo -n true >/dev/null 2>&1; then
        privilege_command=(sudo -n pacman -U --noconfirm "$package_file")
    elif command -v pkexec >/dev/null 2>&1; then
        privilege_command=(pkexec /usr/bin/pacman -U --noconfirm "$package_file")
    else
        fail E_AUTH "需要管理员授权" "请先在终端运行 sudo -v，然后重试升级。"
    fi
    if ! run_logged "${privilege_command[@]}"; then
        if grep -qiE 'authentication|authorization|not authorized|password is required' "$log_file"; then
            fail_from_log E_AUTH "管理员授权被拒绝或取消"
        fi
        fail_from_log E_INSTALL "pacman 安装失败"
    fi

    progress 94 "正在验证安装结果" "确认 pacman 数据库和已安装版本。" false
    installed_after=$(pacman -Q "$PACKAGE_NAME" 2>>"$log_file" | awk '{print $2}') ||
        fail_from_log E_POST_INSTALL "安装后无法读取版本"
    [[ ${installed_after%-[0-9]*} == "$target" ]] ||
        fail E_POST_INSTALL "安装后的版本不符合预期" "预期 $target，实际 $installed_after。"
    if ! run_logged pacman -Qkk "$PACKAGE_NAME"; then
        fail_from_log E_POST_INSTALL "安装后的文件完整性检查失败"
    fi

    if grep -qiE 'failed to create snapshot|failed to create subvolume snapshot' "$log_file"; then
        warning W_SYSTEM_HOOK "系统快照钩子未成功" "CC Switch 已安装，但 Timeshift Btrfs 快照未创建；请单独检查 Timeshift。"
    fi
    progress 100 "更新已准备完成" "CC Switch $target 已由 pacman 管理。" false
    event RESULT success "$target" "更新已安装。请重启 CC Switch 以载入新版本。"
}

main "$@"
