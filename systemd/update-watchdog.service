[Unit]
Description=Native update watchdog tray for CC Switch, ChatGPT Desktop, and OpenAI Codex pre-releases
After=network-online.target plasma-workspace.target
PartOf=plasma-workspace.target

[Service]
Type=simple
ExecStart=%h/.local/bin/update-watchdog-tray
Restart=on-failure
RestartSec=5s

[Install]
WantedBy=plasma-workspace.target
