package() {
  local data_member
  data_member=$(ar t "${srcdir}/chatgpt_${pkgver}_amd64.deb" | awk '/^data\.tar\./ { print; exit }')
  [[ -n ${data_member} ]] || return 1
  ar p "${srcdir}/chatgpt_${pkgver}_amd64.deb" "${data_member}" |
    bsdtar --no-same-owner -xf - -C "${pkgdir}"

  install -Dm755 "${srcdir}/chatgpt-launcher.sh" \
